{
  "expo": {
    "name": "hbplus-auth-app",
    "slug": "hbplus-auth-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "hbplusauth",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hbplus.authapp"
    },
    "android": {
      "package": "com.hbplus.authapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "10e25116-7a9b-4e92-b091-40a160edcf58"
      }
    },
    "owner": "rani12"
  }
}
